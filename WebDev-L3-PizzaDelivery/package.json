{
  "name": "oibsip-pizza-delivery",
  "version": "0.1.0",
  "private": true,
  "description": "OIBSIP Pizza Delivery Application - Phase 1",
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev:client": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "build:client": "npm run build --workspace=client",
    "seed": "node --env-file=server/.env server/src/scripts/seedDatabase.js",
    "test": "npm run test:backend && npm run test:frontend",
    "test:coverage": "vitest --coverage",
    "test:integration": "vitest --config tests/vitest.config.integration.js",
    "test:backend": "vitest run --config tests/vitest.config.js",
    "test:frontend": "npm run test:frontend --workspace=client",
    "test:watch": "vitest"
  },
  "engines": {
    "node": "^24.0.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.0.5",
    "mongodb-memory-server": "11.3.0",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  },
  "author": "",
  "license": "ISC"
}
