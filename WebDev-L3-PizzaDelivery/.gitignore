# =============================================
# SUNNYS Pizza / OIBSIP — Git ignore rules
# =============================================

# Dependencies
node_modules/
.pnp.*

# Local environment variables and secrets
.env
.env.*
!.env.example
!.env.*.example
*.pem

# Internal documentation and governance
.governance/
*.md

# Build output and coverage
**/dist/
**/build/
coverage/
**/coverage/
*.tsbuildinfo

# Test caches and generated test uploads
.vitest/
**/.vitest/


# Temporary files and logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tmp
*.temp
seed-data-summary.txt

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# Editor-specific local files
.idea/
*.swp
*.swo

# =============================================
# Pizza images — deliberately committed
# =============================================

# Keep project images under server/uploads/
# and client/public/.

# Do not ignore image extensions such as
# *.png, *.jpg, *.jpeg, or *.webp.

!/server/uploads/
!/server/uploads/**

!/client/public/
!/client/public/**

# Include the public project README
!/README.md